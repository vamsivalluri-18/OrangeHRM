<?xml version="1.0" encoding="UTF-8"?>
<!-- Bind to grammar/schema... -->
<Configuration status="INFO">

    <Properties>
        <Property name="basePath">./logs</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <RollingFile name="File" fileName="${basePath}/automation.log" filePattern="${basePath}/automation-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <SizeBasedTriggeringPolicy size="50000" />
        </RollingFile>

    </Appenders>

    <Loggers>
        <Root level="info"><!-- Here you can use multiple log levels All < Trace < Debug < Info < Warn < Error < Fatal -->
            <!-- <AppenderRef ref="Console"/> -->
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>

</Configuration>
